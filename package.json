{
  "name": "auto-clipper",
  "private": true,
  "version": "1.19.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:cloud": "tsc && vite build --mode cloud",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "oxlint src"
  },
  "build": {
    "appId": "com.autoclipper.app",
    "productName": "Auto Clipper",
    "artifactName": "Auto Clipper Setup ${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.2",
    "axios": "^1.6.0",
    "i18next": "^26.3.6",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.24.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-stronghold": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "ffmpeg-static": "^5.3.0"
  }
}
